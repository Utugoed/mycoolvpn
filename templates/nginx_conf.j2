user www-data;
worker_processes auto;
pid /run/nginx.pid;
include /etc/nginx/modules-enabled/*.conf;

events {
        worker_connections 768;
        # multi_accept on;
}

stream {
        upstream vpn {
                server {{ hostvars[item]['ansible_host'] }}:443;
        }

        server {
                listen 443;
                proxy_pass vpn;
        }
}